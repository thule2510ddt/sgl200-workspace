/dts-v1/;
#include <st/g4/stm32g431Xb.dtsi>
#include <st/g4/stm32g431c(6-8-b)ux-pinctrl.dtsi>

/ {
	model = "Saolatek SGL-200 v1";
	compatible = "saolatek,sgl200-v1";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";

		status_led: led_0 {
			gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
			label = "Status LED";
		};

		led_red: led_1 {
			gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
			label = "AUX LED Red";
		};

		led_blue: led_2 {
			gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
			label = "AUX LED Blue";
		};

		led_ir: led_3 {
			gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
			label = "AUX LED IR";
		};
	};

	aliases {
		imu0 = &icm42688;
		led-pwm = &pwm_led;
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led: pwm_led_0 {
			pwms = <&pwm3 1 PWM_USEC(50) PWM_POLARITY_NORMAL>;
			label = "Main LED PWM";
		};
	};
};

&clk_hse {
	status = "okay";
	clock-frequency = <DT_FREQ_M(12)>;
};

&pll {
	div-m = <3>;
	mul-n = <85>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(170)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	icm42688: icm42688@0 {
		compatible = "saolatek,icm42688";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(24)>;
		int-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
	};
};

&usart2 {
	status = "okay";
	pinctrl-0 = <&usart2_tx_pa2>;
	pinctrl-names = "default";
	current-speed = <1000000>;
	single-wire;
};

&usart3 {
	status = "okay";
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <921600>;
};

&timers3 {
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pb4>;
		pinctrl-names = "default";
	};
};

&adc1 {
	status = "okay";
	pinctrl-0 = <&adc1_in1_pa0 &adc1_in2_pa1>;
	pinctrl-names = "default";
	st,adc-clock-source = <SYNC>;
	st,adc-prescaler = <4>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&fdcan1 {
	status = "disabled";
};

&iwdg {
	status = "okay";
};
